{
  "manifest_version": 3,
  "name": "Commbox Quick Copy",
  "version": "1.0.0",
  "description": "Copy the currently open Commbox conversation to the clipboard with one keypress.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.commbox.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
